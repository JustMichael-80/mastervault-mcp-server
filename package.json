{
  "name": "mastervault-mcp-server",
  "version": "1.0.1",
  "description": "A headless, filesystem-backed MCP server that serves any MasterVault \u2014 its files and its operating protocol \u2014 to any MCP client. No Obsidian required.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mastervault-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustMichael-80/mastervault-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "vault",
    "mastervault",
    "stdio",
    "knowledge-base",
    "second-brain"
  ],
  "author": "ChronoDyne Systems, Inc.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}